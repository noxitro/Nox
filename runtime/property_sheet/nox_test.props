<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    GoogleTest 実行ファイル (*_test.vcxproj) 共通の設定。
    nox_common.props / nox_<構成>.props / nox_x64.props の後に読むこと
    (nox_common.props の NoxVcpkgInstalledDir と LinkIncremental を前提にしている)。

    テストプロジェクトはモジュールごとに増えていくので、gtest のリンク方法を
    変えたときに全テストの vcxproj を直して回らずに済むよう、ここへ集めてある。
    tools/module-test/new-module-test.ps1 が生成するプロジェクトはこれを読む。

    gtest は vcpkg の x64-windows トリプレットで DLL としてビルドされるため、
      - GTEST_LINKED_AS_SHARED_LIBRARY を定義する
      - インポートライブラリ gtest.lib をリンクする
      - gtest.dll を実行ファイルの隣へコピーする
    の 3 つが要る。DLL の置き場は Debug だけ debug\bin\ 側。
  -->
  <PropertyGroup>
    <_PropertySheetDisplayName>nox_test</_PropertySheetDisplayName>
    <NoxGTestBinDir Condition="'$(Configuration)'=='Debug'">$(NoxVcpkgInstalledDir)debug\bin\</NoxGTestBinDir>
    <NoxGTestBinDir Condition="'$(NoxGTestBinDir)'==''">$(NoxVcpkgInstalledDir)bin\</NoxGTestBinDir>
    <!-- Release / Master は /GL が付くので、インクリメンタルリンクは効かない (LNK4075 になる) -->
    <LinkIncremental Condition="'$(Configuration)'!='Debug'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- $(ProjectDir).. はテスト対象 (test/ の親) を指す -->
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GTEST_LINKED_AS_SHARED_LIBRARY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>gtest.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>copy /Y "$(NoxGTestBinDir)gtest.dll" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Debug'">
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>

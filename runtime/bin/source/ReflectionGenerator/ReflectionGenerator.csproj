<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- 単一ファイル -->
    <PublishSingleFile>true</PublishSingleFile>

	  <!-- ネイティブ(libclang など) を自己展開させる -->
	  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

	  <!-- PDB を外へ出したくない場合 -->
	  <!--<DebugType>none</DebugType>-->
	  <!--<DebugSymbols>false</DebugSymbols>-->

	  <!--BinaryFormatterを使えるようにする-->
	<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ClangSharpPInvokeGenerator\**" />
    <EmbeddedResource Remove="ClangSharpPInvokeGenerator\**" />
    <None Remove="ClangSharpPInvokeGenerator\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" Version="21.1.8.2" />
    <PackageReference Include="ClangSharp.Interop" Version="21.1.8.2" />
    <PackageReference Include="libclang.runtime.win-x64" Version="21.1.8" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="21.1.8.2" />
    <PackageReference Include="Microsoft.Build" Version="18.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RuntimeTypeDB\RuntimeTypeDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CustomTask">
      <HintPath>..\CustomTask\bin\x64\Release\netstandard2.0\CustomTask.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Info\" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8" ?>
<Project>
	<!-- vcxproj と同じディレクトリにあるMyCustomTask.dll のタスクを使用 -->
  <UsingTask
    TaskName="Nox.CustomTask.Task"
    AssemblyFile="$(SolutionDir)bin\CustomTask.dll" />

	<!--変数定義-->
	<!--Debug構成-->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<ConfigurationDefine>NOX_DEBUG</ConfigurationDefine>
	</PropertyGroup>

	<!--Release構成-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<ConfigurationDefine>NOX_RELEASE</ConfigurationDefine>
	</PropertyGroup>
	
	<!--Master構成-->
	<PropertyGroup Condition="'$(Configuration)' == 'Master'">
		<ConfigurationDefine>NOX_MASTER</ConfigurationDefine>
	</PropertyGroup>
	
	<!--x64構成-->
	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<PlatformDefine>NOX_WIN64</PlatformDefine>
	</PropertyGroup>

	<!-- C++バージョンの定義 -->
	<PropertyGroup>
		<CppVersion>-std=c++2b</CppVersion>
	</PropertyGroup>

	<!--
		リフレクション解析用のシステムインクルードパス。

		リフレクション情報は「どの型・メンバが存在するか」を表すものであり、
		ビルドに使うコンパイラによって変わってはならない。
		$(IncludePath) は選択中のツールセットが決めるため使わない。
		ClangCL では先頭に VS 同梱 clang の組み込みヘッダ
		(VC\Tools\Llvm\x64\lib\clang\<major>\include) が差し込まれるが、
		ReflectionGenerator.exe が解析に使うのは同梱版とはバージョンの異なる
		libclang (ClangSharp) なので、新しい組み込み関数を知らずに解析が失敗する。
		そのため $(PlatformToolset) に依存しない MSVC + Windows SDK の
		インクルードパスだけを明示的に渡す(この2つはどのツールセットでも同じ値)。
	-->
	<PropertyGroup>
		<ReflectionParseIncludePath>$(VC_IncludePath);$(WindowsSDK_IncludePath)</ReflectionParseIncludePath>
	</PropertyGroup>

	<!--
		RuntimeTypeDB (Editor が読む型 DB) を書き出すか。
		書き出すと %TEMP% のポインタファイルも置き直すので、Editor は最後に建てた方を読む。
		テスト用の型を含む reflection_generated_test が書くと Editor がそれを読んでしまうので、
		そちらでは false にする (reflection_generated_test/Directory.Build.targets)。
	-->
	<PropertyGroup>
		<NoxReflectionWriteTypeDB Condition="'$(NoxReflectionWriteTypeDB)' == ''">true</NoxReflectionWriteTypeDB>
	</PropertyGroup>

	<!--変数定義end-->

	<!--
		コード生成器の鮮度検査

		runtime\bin の CustomTask.dll / ReflectionGenerator.exe は .gitignore 済みで、
		リポジトリ直下の startup.ps1 (startup.bat) が runtime\bin\source から建てて配置する。
		pull で生成器のソースだけが新しくなり配置済みのバイナリが古いままだと、生成コードが
		今のソースと食い違い、原因の見えにくいコンパイルエラーが大量に出る。
		そこで、生成器のソースが startup.ps1 の書く印 (startup.stamp) より新しいか、印が無ければ
		ここで止めて startup.bat の実行を促す。

		ここで建て直さないのは、CustomTask.dll を Visual Studio の MSBuild が読み込んで
		掴んだままにするため (ビルドの途中では上書きできない)。
		git は pull で書き換えたファイルの更新日時を新しくするので、更新日時の比較で足りる。
	-->
	<PropertyGroup>
		<NoxCodeGeneratorSourceDir>$(SolutionDir)bin\source\</NoxCodeGeneratorSourceDir>
		<NoxCodeGeneratorStamp>$(SolutionDir)bin\startup.stamp</NoxCodeGeneratorStamp>
	</PropertyGroup>
	<ItemGroup>
		<NoxCodeGeneratorSource Include="$(NoxCodeGeneratorSourceDir)CustomTask\*.cs;$(NoxCodeGeneratorSourceDir)CustomTask\*.csproj" />
		<NoxCodeGeneratorSource Include="$(NoxCodeGeneratorSourceDir)RuntimeTypeDB\*.cs;$(NoxCodeGeneratorSourceDir)RuntimeTypeDB\*.csproj" />
		<NoxCodeGeneratorSource Include="$(NoxCodeGeneratorSourceDir)ReflectionGenerator\*.cs;$(NoxCodeGeneratorSourceDir)ReflectionGenerator\*.csproj" />
		<NoxCodeGeneratorSource Include="$(NoxCodeGeneratorSourceDir)ReflectionGenerator\Generator\**\*.cs;$(NoxCodeGeneratorSourceDir)ReflectionGenerator\Parser\**\*.cs" />
	</ItemGroup>

	<Target
		Name="NoxCheckCodeGenerator"
		BeforeTargets="ReflectionGeneratorPreProcess"
		Inputs="@(NoxCodeGeneratorSource)"
		Outputs="$(NoxCodeGeneratorStamp)">
		<Error Text="runtime\bin のコード生成器 (CustomTask.dll / ReflectionGenerator.exe) が runtime\bin\source のソースより古いか、配置されていません。リポジトリ直下の startup.bat を実行してから、ビルドし直してください。" />
	</Target>
	
  <!-- 独自ターゲット -->
  <Target
    Name="ReflectionGeneratorPreProcess"
    BeforeTargets="ClCompile">
    <!-- カスタムタスクを呼び出す -->
	  <Nox.CustomTask.Task
		  SourceFiles="@(ClCompile)"
		  AdditionalIncludeDirectories="$(ReflectionParseIncludePath);%(ClCompile.AdditionalIncludeDirectories)"
		  PreprocessorMacro="%(ClCompile.PreprocessorDefinitions)"
		  AdditionalOptions="%(ClCompile.AdditionalOptions)"
		  SolutionDir="$(SolutionDir)"
		  SolutionPath="$(SolutionPath)"
		  ProjectDir="$(ProjectDir)"
		  ProjectPath="$(ProjectPath)"
		  
		  OutputGenerateDir="$(ProjectDir)gen"
		 
		  Configuration="$(Configuration)"
		  ConfigurationDefine="$(ConfigurationDefine)"
		  Platform="$(Platform)"
		  PlatformDefine="$(PlatformDefine)"
		  IntermediateOutputPath="$(IntermediateOutputPath)"
		  OutDir="$(OutDir)"
		  MSBuildBinPath="$(MSBuildBinPath)"
		  Optimization="%(ClCompile.Optimization)"
		  ReflectionTargetSourceFile="$(ProjectDir)reflect.cpp"
		  CppVersion="$(CppVersion)"
		  UseRtti="%(ClCompile.RuntimeTypeInfo)"
		  />

	  <!--
		  ReflectionGenerator.exe 呼び出し

		  C++ ビルドでは MSBuild が環境変数 INCLUDE に $(IncludePath) を書き出しており、
		  子プロセスにもそのまま引き継がれる。libclang は MSVC 互換ドライバとして
		  INCLUDE をシステムインクルードパスとして読むため、-I を明示していても
		  ClangCL のときは VS 同梱 clang の組み込みヘッダを拾ってしまう。
		  解析結果をツールセットに依存させないため、INCLUDE も
		  $(ReflectionParseIncludePath) で上書きする(MSVC のときは同じ値になる)。
		  ; を含む値を 1 項目として渡すためにエスケープしている。
	  -->
	  <Exec
		Condition="Exists('$(SolutionDir)bin\ReflectionGenerator.exe')"
		EnvironmentVariables="INCLUDE=$([MSBuild]::Escape('$(ReflectionParseIncludePath)'))"
		Command="&quot;$(SolutionDir)bin\ReflectionGenerator.exe&quot; -project &quot;$(ProjectPath)&quot; -solution &quot;$(SolutionPath)&quot; -config &quot;$(Configuration)&quot; -platform &quot;$(Platform)&quot; -out &quot;$(ProjectDir)gen&quot; -typedb $(NoxReflectionWriteTypeDB)" />

	  <!-- 生成された per-type ファイルを取り込む -->
	  <ItemGroup>
		  <ClCompile Include="$(ProjectDir)gen\$(Platform)\$(Configuration)\entity_type_*.g.cpp" />
	  </ItemGroup>

	  <!-- 無い場合の警告 -->
	  <Warning Condition="!Exists('$(SolutionDir)bin\ReflectionGenerator.exe')"
			   Text="ReflectionGenerator.exe が見つかりません: $(SolutionDir)bin\ReflectionGenerator.exe" />

  </Target>
</Project>
    <Color x:Key="Nox.Color.DangerForeground">#FFFFECEC</Color>
    <Color x:Key="Nox.Color.DangerBorder">#FF7A3E43</Color>
    <Color x:Key="Nox.Color.ErrorText">#FFFF8C7A</Color>
    <Color x:Key="Nox.Color.MenuBackground">#FF1B2028</Color>
    <Color x:Key="Nox.Color.TabBarBackground">#FF111419</Color>
    <Color x:Key="Nox.Color.TabHoverBackground">#FF242B35</Color>
    <Color x:Key="Nox.Color.TabSelectedBackground">#FF2B3440</Color>
    <Color x:Key="Nox.Color.TabHoverBorder">#FF374456</Color>
    <Color x:Key="Nox.Color.TabSelectedBorder">#FF46566A</Color>

    <Color x:Key="Nox.Color.Inspector.Background">#FF070A18</Color>
    <Color x:Key="Nox.Color.Inspector.HeaderBackground">#FF101737</Color>
    <Color x:Key="Nox.Color.Inspector.Border">#FFFF2BD6</Color>
    <Color x:Key="Nox.Color.Inspector.TitleForeground">#FF00E5FF</Color>
    <Color x:Key="Nox.Color.Inspector.DescriptionForeground">#FFFFF15A</Color>
    <Color x:Key="Nox.Color.Inspector.PropertyNameForeground">#FF00FFB3</Color>
    <Color x:Key="Nox.Color.Inspector.PropertyValueForeground">#FFEFFFFF</Color>

    <SolidColorBrush x:Key="Nox.Brush.WindowBackground" Color="{StaticResource Nox.Color.WindowBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.PanelBackground" Color="{StaticResource Nox.Color.PanelBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.PanelBorder" Color="{StaticResource Nox.Color.PanelBorder}" />

    <SolidColorBrush x:Key="Nox.Brush.ControlBackground" Color="{StaticResource Nox.Color.ControlBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.ControlBackgroundHover" Color="{StaticResource Nox.Color.ControlBackgroundHover}" />
    <SolidColorBrush x:Key="Nox.Brush.ControlBackgroundPressed" Color="{StaticResource Nox.Color.ControlBackgroundPressed}" />
    <SolidColorBrush x:Key="Nox.Brush.InputBackground" Color="{StaticResource Nox.Color.InputBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.HeaderBackground" Color="{StaticResource Nox.Color.HeaderBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.HeaderBackgroundActive" Color="{StaticResource Nox.Color.HeaderBackgroundActive}" />
    <SolidColorBrush x:Key="Nox.Brush.HeaderBackgroundInactive" Color="{StaticResource Nox.Color.HeaderBackgroundInactive}" />
    <SolidColorBrush x:Key="Nox.Brush.HeaderBackgroundHover" Color="{StaticResource Nox.Color.HeaderBackgroundHover}" />
    <SolidColorBrush x:Key="Nox.Brush.GridLine" Color="{StaticResource Nox.Color.GridLine}" />
    <SolidColorBrush x:Key="Nox.Brush.SelectionBackground" Color="{StaticResource Nox.Color.SelectionBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.SurfaceBackground" Color="{StaticResource Nox.Color.SurfaceBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.SurfaceRaised" Color="{StaticResource Nox.Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Nox.Brush.CommandBarBackground" Color="{StaticResource Nox.Color.CommandBarBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.CommandBarBadgeBackground" Color="{StaticResource Nox.Color.CommandBarBadgeBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.CommandBadgeBackground" Color="{StaticResource Nox.Color.CommandBadgeBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.IconBackground" Color="{StaticResource Nox.Color.IconBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.ControlBorder" Color="{StaticResource Nox.Color.ControlBorder}" />
    <SolidColorBrush x:Key="Nox.Brush.ControlBorderHover" Color="{StaticResource Nox.Color.ControlBorderHover}" />
    <SolidColorBrush x:Key="Nox.Brush.ControlBorderPressed" Color="{StaticResource Nox.Color.ControlBorderPressed}" />
    <SolidColorBrush x:Key="Nox.Brush.IconBorder" Color="{StaticResource Nox.Color.IconBorder}" />
    <SolidColorBrush x:Key="Nox.Brush.BadgeBorder" Color="{StaticResource Nox.Color.BadgeBorder}" />

    <SolidColorBrush x:Key="Nox.Brush.TextPrimary" Color="{StaticResource Nox.Color.TextPrimary}" />
    <SolidColorBrush x:Key="Nox.Brush.TextSecondary" Color="{StaticResource Nox.Color.TextSecondary}" />
    <SolidColorBrush x:Key="Nox.Brush.TextHeading" Color="{StaticResource Nox.Color.TextHeading}" />
    <SolidColorBrush x:Key="Nox.Brush.TextStrong" Color="{StaticResource Nox.Color.TextStrong}" />
    <SolidColorBrush x:Key="Nox.Brush.TextMuted" Color="{StaticResource Nox.Color.TextMuted}" />
    <SolidColorBrush x:Key="Nox.Brush.TextTertiary" Color="{StaticResource Nox.Color.TextTertiary}" />
    <SolidColorBrush x:Key="Nox.Brush.TextSubtle" Color="{StaticResource Nox.Color.TextSubtle}" />
    <SolidColorBrush x:Key="Nox.Brush.Accent" Color="{StaticResource Nox.Color.Accent}" />
    <SolidColorBrush x:Key="Nox.Brush.AccentHover" Color="{StaticResource Nox.Color.AccentHover}" />
    <SolidColorBrush x:Key="Nox.Brush.AccentForeground" Color="{StaticResource Nox.Color.AccentForeground}" />
    <SolidColorBrush x:Key="Nox.Brush.AccentBorder" Color="{StaticResource Nox.Color.AccentBorder}" />
    <SolidColorBrush x:Key="Nox.Brush.AccentBorderHover" Color="{StaticResource Nox.Color.AccentBorderHover}" />
    <SolidColorBrush x:Key="Nox.Brush.Danger" Color="{StaticResource Nox.Color.Danger}" />
    <SolidColorBrush x:Key="Nox.Brush.DangerForeground" Color="{StaticResource Nox.Color.DangerForeground}" />
    <SolidColorBrush x:Key="Nox.Brush.DangerBorder" Color="{StaticResource Nox.Color.DangerBorder}" />
    <SolidColorBrush x:Key="Nox.Brush.ErrorText" Color="{StaticResource Nox.Color.ErrorText}" />
    <SolidColorBrush x:Key="Nox.Brush.MenuBackground" Color="{StaticResource Nox.Color.MenuBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.TabBarBackground" Color="{StaticResource Nox.Color.TabBarBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.TabHoverBackground" Color="{StaticResource Nox.Color.TabHoverBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.TabSelectedBackground" Color="{StaticResource Nox.Color.TabSelectedBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.TabHoverBorder" Color="{StaticResource Nox.Color.TabHoverBorder}" />
    <SolidColorBrush x:Key="Nox.Brush.TabSelectedBorder" Color="{StaticResource Nox.Color.TabSelectedBorder}" />

    <SolidColorBrush x:Key="Nox.Brush.Inspector.Background" Color="{StaticResource Nox.Color.Inspector.Background}" />
    <SolidColorBrush x:Key="Nox.Brush.Inspector.HeaderBackground" Color="{StaticResource Nox.Color.Inspector.HeaderBackground}" />
    <SolidColorBrush x:Key="Nox.Brush.Inspector.Border" Color="{StaticResource Nox.Color.Inspector.Border}" />
    <SolidColorBrush x:Key="Nox.Brush.Inspector.TitleForeground" Color="{StaticResource Nox.Color.Inspector.TitleForeground}" />
    <SolidColorBrush x:Key="Nox.Brush.Inspector.DescriptionForeground" Color="{StaticResource Nox.Color.Inspector.DescriptionForeground}" />
    <SolidColorBrush x:Key="Nox.Brush.Inspector.PropertyNameForeground" Color="{StaticResource Nox.Color.Inspector.PropertyNameForeground}" />
    <SolidColorBrush x:Key="Nox.Brush.Inspector.PropertyValueForeground" Color="{StaticResource Nox.Color.Inspector.PropertyValueForeground}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource Nox.Color.WindowBackground}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource Nox.Color.ControlBackground}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource Nox.Color.ControlBackgroundHover}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource Nox.Color.GridLine}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource Nox.Color.TextPrimary}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource Nox.Color.TextPrimary}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Nox.Color.SelectionBackground}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Nox.Color.TextPrimary}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Nox.Color.SelectionBackground}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Nox.Color.TextPrimary}" />

    <StaticResource x:Key="PanelBorderBrush" ResourceKey="Nox.Brush.GridLine" />
    <StaticResource x:Key="FloatingDocumentWindowBackground" ResourceKey="Nox.Brush.PanelBackground" />
    <StaticResource x:Key="FloatingDocumentWindowBorder" ResourceKey="Nox.Brush.GridLine" />
    <StaticResource x:Key="FloatingToolWindowBackground" ResourceKey="Nox.Brush.PanelBackground" />
    <StaticResource x:Key="FloatingToolWindowBorder" ResourceKey="Nox.Brush.GridLine" />

    <StaticResource x:Key="DocumentWellTabSelectedActiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundActive" />
    <StaticResource x:Key="DocumentWellTabSelectedActiveText" ResourceKey="Nox.Brush.TextPrimary" />
    <StaticResource x:Key="DocumentWellTabSelectedInactiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundInactive" />
    <StaticResource x:Key="DocumentWellTabSelectedInactiveText" ResourceKey="Nox.Brush.TextSecondary" />
    <StaticResource x:Key="DocumentWellTabUnselectedBackground" ResourceKey="Nox.Brush.HeaderBackground" />
    <StaticResource x:Key="DocumentWellTabUnselectedText" ResourceKey="Nox.Brush.TextSecondary" />
    <StaticResource x:Key="DocumentWellTabUnselectedHoveredBackground" ResourceKey="Nox.Brush.HeaderBackgroundHover" />
    <StaticResource x:Key="DocumentWellTabUnselectedHoveredText" ResourceKey="Nox.Brush.TextPrimary" />

    <StaticResource x:Key="ToolWindowCaptionActiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundActive" />
    <StaticResource x:Key="ToolWindowCaptionActiveText" ResourceKey="Nox.Brush.TextPrimary" />
    <StaticResource x:Key="ToolWindowCaptionActiveGrip" ResourceKey="Nox.Brush.Accent" />
    <StaticResource x:Key="ToolWindowCaptionInactiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundInactive" />
    <StaticResource x:Key="ToolWindowCaptionInactiveText" ResourceKey="Nox.Brush.TextSecondary" />
    <StaticResource x:Key="ToolWindowCaptionInactiveGrip" ResourceKey="Nox.Brush.GridLine" />
    <StaticResource x:Key="ToolWindowTabSelectedActiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundActive" />
    <StaticResource x:Key="ToolWindowTabSelectedActiveText" ResourceKey="Nox.Brush.TextPrimary" />
    <StaticResource x:Key="ToolWindowTabSelectedInactiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundInactive" />
    <StaticResource x:Key="ToolWindowTabSelectedInactiveText" ResourceKey="Nox.Brush.TextSecondary" />
    <StaticResource x:Key="ToolWindowTabUnselectedBackground" ResourceKey="Nox.Brush.HeaderBackground" />
    <StaticResource x:Key="ToolWindowTabUnselectedText" ResourceKey="Nox.Brush.TextSecondary" />
    <StaticResource x:Key="ToolWindowTabUnselectedHoveredBackground" ResourceKey="Nox.Brush.HeaderBackgroundHover" />
    <StaticResource x:Key="ToolWindowTabUnselectedHoveredText" ResourceKey="Nox.Brush.TextPrimary" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type UserControl}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Nox.Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.ControlBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
    </Style>

    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
    </Style>

    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.ControlBackgroundHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.PanelBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
    </Style>

    <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Nox.Brush.ControlBackgroundHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Nox.Brush.Accent}" />
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.ControlBackgroundHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True" />
                    <Condition Property="IsKeyboardFocusWithin" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.SelectionBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
    </Style>

    <Style TargetType="{x:Type adControls:AnchorablePaneTitle}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundInactive}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Model.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundInactive}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Model.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundActive}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.Accent}" />
                <Setter Property="BorderThickness" Value="1,1,1,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type adControls:LayoutAnchorableTabItem}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Model.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundInactive}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Model.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundActive}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.Accent}" />
                <Setter Property="BorderThickness" Value="1,1,1,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type adControls:LayoutDocumentTabItem}">
        <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Model.IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundInactive}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Model.IsActive, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nox.Brush.HeaderBackgroundActive}" />
                <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.Accent}" />
                <Setter Property="BorderThickness" Value="1,1,1,3" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

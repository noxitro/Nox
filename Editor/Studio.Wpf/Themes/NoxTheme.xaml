    <StaticResource x:Key="ToolWindowCaptionActiveGrip" ResourceKey="Nox.Brush.Accent" />
    <StaticResource x:Key="ToolWindowCaptionInactiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundInactive" />
    <StaticResource x:Key="ToolWindowCaptionInactiveText" ResourceKey="Nox.Brush.TextSecondary" />
    <StaticResource x:Key="ToolWindowCaptionInactiveGrip" ResourceKey="Nox.Brush.GridLine" />
    <StaticResource x:Key="ToolWindowTabSelectedActiveBackground" ResourceKey="Nox.Brush.HeaderBackgroundActive" />
    <StaticResource x:Key="ToolWindowTabSelectedActiveText" ResourceKey="Nox.Brush.TextPrimary" />

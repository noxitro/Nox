<!-- Brushed Steel: やや明るめのシルバー寄りメタル -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Metallic.HighlightColor">#FFC7CDD2</Color>
    <Color x:Key="Metallic.LightColor">#FF9AA1A8</Color>
    <Color x:Key="Metallic.MidColor">#FF6E757B</Color>
    <Color x:Key="Metallic.DarkColor">#FF3A4047</Color>
    <Color x:Key="Metallic.AccentColor">#FF3FA9F5</Color>
    <Color x:Key="Metallic.TextColor">#FFF2F4F6</Color>
    <Color x:Key="Metallic.TextDimColor">#FFB4BAC0</Color>
    <Color x:Key="Metallic.BorderColor">#FF1F2326</Color>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Studio.Wpf;component/Themes/NoxTheme.xaml" />
        <ResourceDictionary
            Source="/Studio.Wpf;component/Themes/Shared/MetallicShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>

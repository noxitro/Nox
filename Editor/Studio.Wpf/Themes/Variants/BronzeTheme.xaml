<!-- Bronze: 暖色系メタル -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Metallic.HighlightColor">#FF8A6A3A</Color>
    <Color x:Key="Metallic.LightColor">#FF5C4626</Color>
    <Color x:Key="Metallic.MidColor">#FF3E2F1B</Color>
    <Color x:Key="Metallic.DarkColor">#FF231910</Color>
    <Color x:Key="Metallic.AccentColor">#FFC9A24A</Color>
    <Color x:Key="Metallic.TextColor">#FFEFE6D6</Color>
    <Color x:Key="Metallic.TextDimColor">#FFB39A75</Color>
    <Color x:Key="Metallic.BorderColor">#FF120C07</Color>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
            Source="/Studio.Wpf;component/Themes/Shared/MetallicShared.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>

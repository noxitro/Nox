<UserControl x:Class="Studio.Wpf.Views.ThemeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:noxui="clr-namespace:NoxUI;assembly=NoxUI"
             xmlns:vm="clr-namespace:Studio.Wpf.ViewModels"
             xmlns:local="clr-namespace:Studio.Wpf.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ThemeSettingsViewModel, IsDesignTimeCreatable=False}"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:ThemeHexToBrushConverter x:Key="ThemeHexToBrushConverter" />

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextHeading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ThemeSettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.ControlBorder}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ThemeSettingsListViewStyle" TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.GridLine}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Nox.Brush.SurfaceBackground}"
            BorderBrush="{DynamicResource Nox.Brush.GridLine}"
            BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="10"
                    Background="{DynamicResource Nox.Brush.HeaderBackground}"
                    BorderBrush="{DynamicResource Nox.Brush.GridLine}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Theme Settings"
                                   Foreground="{DynamicResource Nox.Brush.TextHeading}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                   FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Save Custom"
                                MinWidth="104"
                                Height="28"
                                Margin="0,0,6,0"
                                Command="{Binding SaveCustomThemeCommand}" />
                        <Button Content="Apply Custom"
                                MinWidth="104"
                                Height="28"
                                Command="{Binding ApplyCustomThemeCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
            <Grid Margin="12"
                  MinWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">
                    <TextBlock Text="Default Themes"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <ListView ItemsSource="{Binding BuiltInThemes}"
                              SelectedItem="{Binding SelectedBuiltInTheme, Mode=TwoWay}"
                              Style="{StaticResource ThemeSettingsListViewStyle}"
                              MinHeight="170">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Nox.Brush.TextPrimary}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Apply Built-in Theme"
                            Height="28"
                            Margin="0,8,0,0"
                            Command="{Binding ApplyBuiltInThemeCommand}" />

                    <Border Margin="0,16,0,16"
                            Height="1"
                            Background="{DynamicResource Nox.Brush.GridLine}" />

                    <TextBlock Text="Custom Theme Slots"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <ListView ItemsSource="{Binding CustomThemeSlots}"
                              SelectedItem="{Binding SelectedCustomThemeSlot, Mode=TwoWay}"
                              Style="{StaticResource ThemeSettingsListViewStyle}"
                              MinHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Nox.Brush.TextHeading}"
                                               FontWeight="SemiBold" />
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource Nox.Brush.TextMuted}">
                                        <Run Text="Slot " />
                                        <Run Text="{Binding SlotIndex}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding BaseThemeKey}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding StateText}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Delete Custom Theme"
                            Height="28"
                            Margin="0,8,0,0"
                            Command="{Binding DeleteCustomThemeCommand}" />
                </StackPanel>

                <DockPanel Grid.Column="1"
                           Margin="0,0,12,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Brushes"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <ListView ItemsSource="{Binding Brushes}"
                              SelectedItem="{Binding SelectedBrush, Mode=TwoWay}"
                              Style="{StaticResource ThemeSettingsListViewStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="16"
                                            Height="16"
                                            Margin="0,2,8,2"
                                            Background="{Binding HexValue, Converter={StaticResource ThemeHexToBrushConverter}}"
                                            BorderBrush="{DynamicResource Nox.Brush.ControlBorder}"
                                            BorderThickness="1"
                                            CornerRadius="2" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource Nox.Brush.TextPrimary}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Nox.Brush.TextMuted}">
                                            <Run Text="{Binding Category}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding HexValue}" />
                                        </TextBlock>
                                    </StackPanel>
                                                    </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Selected Custom Theme"
                               Style="{StaticResource SectionHeaderTextStyle}" />
                    <Border Padding="12"
                            Background="{DynamicResource Nox.Brush.SurfaceRaised}"
                            BorderBrush="{DynamicResource Nox.Brush.GridLine}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Name"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     AutomationProperties.Name="Custom theme name"
                                     Style="{StaticResource ThemeSettingsTextBoxStyle}"
                                     Text="{Binding CustomThemeName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1"
                                       Text="Base Theme"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,8,0,0" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      AutomationProperties.Name="Base theme"
                                      Margin="0,8,0,0"
                                      ItemsSource="{Binding BuiltInThemes}"
                                      SelectedItem="{Binding SelectedBaseTheme, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Content="Copy From Base"
                                    Height="28"
                                    Margin="8,8,0,0"
                                    Command="{Binding CopyFromBaseCommand}" />

                            <TextBlock Grid.Row="2"
                                       Text="Brush"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,12,0,0"
                                       Text="{Binding SelectedBrush.DisplayName}"
                                       Foreground="{DynamicResource Nox.Brush.TextHeading}"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Row="3"
                                       Text="Resource Key"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Margin="0,6,0,0"
                                       Text="{Binding SelectedBrush.ResourceKey}"
                                       Foreground="{DynamicResource Nox.Brush.TextTertiary}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="4"
                                       Text="Preview"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <Border Grid.Row="4"
                                    Grid.Column="1"
                                    Width="88"
                                    Height="40"
                                    Margin="0,12,0,0"
                                    Background="{Binding SelectedBrush.HexValue, Converter={StaticResource ThemeHexToBrushConverter}}"
                                    BorderBrush="{DynamicResource Nox.Brush.ControlBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4" />

                            <TextBlock Grid.Row="6"
                                       Text="Hex"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Row="6"
                                     Grid.Column="1"
                                     AutomationProperties.Name="Brush hexadecimal color"
                                     Style="{StaticResource ThemeSettingsTextBoxStyle}"
                                     Text="{Binding SelectedBrush.HexValue, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="6"
                                    Grid.Column="2"
                                    Content="Reset"
                                    Height="28"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResetSelectedBrushCommand}" />

                            <TextBlock Grid.Row="7"
                                       Text="ARGB"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       VerticalAlignment="Top"
                                       Margin="0,12,0,0" />
                            <Grid Grid.Row="7"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="A"
                                           Foreground="{DynamicResource Nox.Brush.TextSubtle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         AutomationProperties.Name="Alpha channel"
                                         Style="{StaticResource ThemeSettingsTextBoxStyle}"
                                         Text="{Binding SelectedBrush.Alpha, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="3"
                                           Text="R"
                                           Foreground="{DynamicResource Nox.Brush.TextSubtle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="4"
                                         AutomationProperties.Name="Red channel"
                                         Style="{StaticResource ThemeSettingsTextBoxStyle}"
                                         Text="{Binding SelectedBrush.Red, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="6"
                                           Text="G"
                                           Foreground="{DynamicResource Nox.Brush.TextSubtle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="7"
                                         AutomationProperties.Name="Green channel"
                                         Style="{StaticResource ThemeSettingsTextBoxStyle}"
                                         Text="{Binding SelectedBrush.Green, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="9"
                                           Text="B"
                                           Foreground="{DynamicResource Nox.Brush.TextSubtle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="10"
                                         AutomationProperties.Name="Blue channel"
                                         Style="{StaticResource ThemeSettingsTextBoxStyle}"
                                         Text="{Binding SelectedBrush.Blue, UpdateSourceTrigger=LostFocus}" />
                            </Grid>

                            <TextBlock Grid.Row="8"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource Nox.Brush.ErrorText}"
                                       AutomationProperties.LiveSetting="Polite"
                                       noxui:LiveRegionBehavior.AnnounceText="{Binding SelectedBrush.ErrorText}"
                                       Text="{Binding SelectedBrush.ErrorText}" />

                            <TextBlock Grid.Row="9"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,12,0,0"
                                       Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                       Text="Built-in themes remain read-only. Save or Apply writes only the selected custom slot." 
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

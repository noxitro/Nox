<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nox\Nox.csproj" />
    <!--
      RuntimeTypeDB はリポジトリ内のプロジェクトなので ProjectReference で参照する。
      以前は runtime\bin\source\RuntimeTypeDB\bin\Release\net10.0\RuntimeTypeDB.dll を
      HintPath で直接指していたが、runtime/bin 配下は .gitignore 済みで、
      その Release 出力を作るビルド手順はリポジトリにも CI にも存在しない
      (CI の setup-nox-build は ReflectionGenerator を -c Debug で建てるだけ)。
      そのため clone 直後は必ず参照解決に失敗し (MSB3245)、CS0246 になっていた。
    -->
    <ProjectReference Include="..\..\runtime\bin\source\RuntimeTypeDB\RuntimeTypeDB.csproj" />

  </ItemGroup>

</Project>

<UserControl x:Class="Core.UI.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:noxui="clr-namespace:NoxUI;assembly=NoxUI"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="360"
             d:DataContext="{d:DesignInstance vm:InspectorViewModel, IsDesignTimeCreatable=False}"
             noxui:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="NoxStudio.InspectorView">
    <UserControl.Resources>
        <Style x:Key="NoxInspectorTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource Nox.SearchTextBoxStyle}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="NoxInspectorButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource Nox.CommandButtonStyle}" />

        <Style x:Key="NoxInspectorComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.ControlBorder}" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.MenuBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextHeading}" />
        </Style>

        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.Inspector.Background}" />
        </Style>

        <DataTemplate DataType="{x:Type vm:PropertyInspectorReadOnlyFieldViewModel}">
            <TextBlock Text="{Binding Value}"
                       Foreground="{DynamicResource Nox.Brush.Inspector.PropertyValueForeground}"
                       TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertyInspectorTextFieldViewModel}">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                     IsReadOnly="{Binding IsReadOnly}"
                     Style="{StaticResource NoxInspectorTextBoxStyle}"
                     AutomationProperties.AutomationId="NoxStudio.PropertyInspector.TextField" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertyInspectorBooleanFieldViewModel}">
            <CheckBox IsChecked="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"
                      Foreground="{DynamicResource Nox.Brush.TextPrimary}"
                      AutomationProperties.AutomationId="NoxStudio.PropertyInspector.BooleanField" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertyInspectorEnumFieldViewModel}">
            <ComboBox ItemsSource="{Binding Values}"
                      SelectedItem="{Binding SelectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsEditable}"
                      Style="{StaticResource NoxInspectorComboBoxStyle}"
                      AutomationProperties.AutomationId="NoxStudio.PropertyInspector.EnumField">
                <ComboBox.Resources>
                    <StaticResource x:Key="{x:Static SystemColors.WindowBrushKey}" ResourceKey="Nox.Brush.MenuBackground" />
                    <StaticResource x:Key="{x:Static SystemColors.WindowTextBrushKey}" ResourceKey="Nox.Brush.TextHeading" />
                    <StaticResource x:Key="{x:Static SystemColors.ControlBrushKey}" ResourceKey="Nox.Brush.MenuBackground" />
                    <StaticResource x:Key="{x:Static SystemColors.ControlTextBrushKey}" ResourceKey="Nox.Brush.TextHeading" />
                    <StaticResource x:Key="{x:Static SystemColors.HighlightBrushKey}" ResourceKey="Nox.Brush.TabHoverBackground" />
                    <StaticResource x:Key="{x:Static SystemColors.HighlightTextBrushKey}" ResourceKey="Nox.Brush.TextStrong" />
                </ComboBox.Resources>
            </ComboBox>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertyInspectorVector3FieldViewModel}">
            <Grid AutomationProperties.AutomationId="NoxStudio.PropertyInspector.Vector3Field">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock DockPanel.Dock="Left" Text="X" Foreground="{DynamicResource Nox.Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding XText, UpdateSourceTrigger=LostFocus}"
                             IsReadOnly="{Binding IsReadOnly}"
                             ToolTip="X value"
                             Style="{StaticResource NoxInspectorTextBoxStyle}" />
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="0,0,4,0">
                    <TextBlock DockPanel.Dock="Left" Text="Y" Foreground="{DynamicResource Nox.Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding YText, UpdateSourceTrigger=LostFocus}"
                             IsReadOnly="{Binding IsReadOnly}"
                             ToolTip="Y value"
                             Style="{StaticResource NoxInspectorTextBoxStyle}" />
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Left" Text="Z" Foreground="{DynamicResource Nox.Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding ZText, UpdateSourceTrigger=LostFocus}"
                             IsReadOnly="{Binding IsReadOnly}"
                             ToolTip="Z value"
                             Style="{StaticResource NoxInspectorTextBoxStyle}" />
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertyInspectorActionFieldViewModel}">
            <Button Content="{Binding DisplayName}"
                    Command="{Binding ExecuteCommand}"
                    Style="{StaticResource NoxInspectorButtonStyle}"
                    AutomationProperties.AutomationId="NoxStudio.PropertyInspector.ActionButton" />
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:InspectorTreeNodeViewModel}" ItemsSource="{Binding Children}">
            <Border Background="{DynamicResource Nox.Brush.Inspector.Background}"
                    BorderBrush="{DynamicResource Nox.Brush.Inspector.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="0"
                    ToolTip="{Binding ToolTipText}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ComponentHeader" Padding="5,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource Nox.Brush.Accent}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Nox.Brush.Inspector.TitleForeground}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TypeName}"
                                           Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="FieldRow" Padding="5,4" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource Nox.Brush.Inspector.PropertyNameForeground}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <ContentPresenter Grid.Column="1"
                                              Content="{Binding Field}"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasField}" Value="True">
                    <Setter TargetName="ComponentHeader" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FieldRow" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Nox.Brush.Inspector.Background}" BorderBrush="{DynamicResource Nox.Brush.Inspector.Border}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Style="{StaticResource Nox.PaneHeaderBorderStyle}"
                    Background="{DynamicResource Nox.Brush.Inspector.HeaderBackground}"
                    BorderBrush="{DynamicResource Nox.Brush.Inspector.Border}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="3" Background="{DynamicResource Nox.Brush.SurfaceBackground}" BorderBrush="{DynamicResource Nox.Brush.Inspector.Border}" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Nox.Brush.Accent}" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock AutomationProperties.AutomationId="NoxStudio.Inspector.TitleText" Text="{Binding Title}" Style="{StaticResource Nox.PaneTitleTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock AutomationProperties.AutomationId="NoxStudio.Inspector.DescriptionText" Text="{Binding Description}" Foreground="{DynamicResource Nox.Brush.Inspector.DescriptionForeground}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="8" Background="{DynamicResource Nox.Brush.Inspector.Background}">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom"
                            Padding="0,8,0,0"
                            Background="{DynamicResource Nox.Brush.Inspector.Background}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanAddComponents}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Height="28"
                                      IsEditable="True"
                                      ItemsSource="{Binding AvailableComponentTypes}"
                                      SelectedItem="{Binding SelectedComponentType, Mode=TwoWay}"
                                      Text="{Binding ComponentTypeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource NoxInspectorComboBoxStyle}"
                                      AutomationProperties.AutomationId="NoxStudio.Inspector.ComponentTypeCombo">
                                <ComboBox.Resources>
                                    <StaticResource x:Key="{x:Static SystemColors.WindowBrushKey}" ResourceKey="Nox.Brush.MenuBackground" />
                                    <StaticResource x:Key="{x:Static SystemColors.WindowTextBrushKey}" ResourceKey="Nox.Brush.TextHeading" />
                                    <StaticResource x:Key="{x:Static SystemColors.ControlBrushKey}" ResourceKey="Nox.Brush.MenuBackground" />
                                    <StaticResource x:Key="{x:Static SystemColors.ControlTextBrushKey}" ResourceKey="Nox.Brush.TextHeading" />
                                    <StaticResource x:Key="{x:Static SystemColors.HighlightBrushKey}" ResourceKey="Nox.Brush.TabHoverBackground" />
                                    <StaticResource x:Key="{x:Static SystemColors.HighlightTextBrushKey}" ResourceKey="Nox.Brush.TextStrong" />
                                </ComboBox.Resources>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="Add Component"
                                    MinWidth="112"
                                    Height="28"
                                    Margin="6,0,0,0"
                                    Command="{Binding AddComponentCommand}"
                                    Style="{StaticResource Nox.PrimaryCommandButtonStyle}"
                                    AutomationProperties.AutomationId="NoxStudio.Inspector.AddComponentButton" />
                        </Grid>
                    </Border>

                    <TreeView ItemsSource="{Binding TreeNodes}"
                              Background="{DynamicResource Nox.Brush.Inspector.Background}"
                              Foreground="{DynamicResource Nox.Brush.TextPrimary}"
                              BorderBrush="{DynamicResource Nox.Brush.Inspector.Border}"
                              BorderThickness="1"
                              Padding="3"
                              AutomationProperties.AutomationId="NoxStudio.Inspector.ComponentTree">
                        <TreeView.Resources>
                            <StaticResource x:Key="{x:Static SystemColors.ControlBrushKey}" ResourceKey="Nox.Brush.Inspector.Background" />
                            <StaticResource x:Key="{x:Static SystemColors.ControlTextBrushKey}" ResourceKey="Nox.Brush.TextPrimary" />
                            <StaticResource x:Key="{x:Static SystemColors.HighlightBrushKey}" ResourceKey="Nox.Brush.TabHoverBackground" />
                            <StaticResource x:Key="{x:Static SystemColors.HighlightTextBrushKey}" ResourceKey="Nox.Brush.TextStrong" />
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</UserControl>

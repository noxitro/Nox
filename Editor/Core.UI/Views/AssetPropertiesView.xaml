<UserControl x:Class="Core.UI.Views.AssetPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="320"
             d:DataContext="{d:DesignInstance vm:AssetPropertiesViewModel, IsDesignTimeCreatable=False}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="NoxStudio.AssetPropertiesView">
    <UserControl.Resources>
        <Style x:Key="AssetPropertiesLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="AssetPropertiesValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextHeading}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="AssetPropertiesEmptyStateStyle" TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAsset}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AssetPropertiesContentStyle" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAsset}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Nox.Brush.SurfaceBackground}"
            BorderBrush="{DynamicResource Nox.Brush.GridLine}"
            BorderThickness="1">
        <Grid>
            <Border Style="{StaticResource AssetPropertiesEmptyStateStyle}"
                    Padding="16"
                    Background="{DynamicResource Nox.Brush.SurfaceBackground}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Nox.Brush.TextMuted}" />
                    <TextBlock Text="{Binding Name}"
                               Margin="0,12,0,4"
                               TextAlignment="Center"
                               Foreground="{DynamicResource Nox.Brush.TextHeading}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}"
                               TextAlignment="Center"
                               Foreground="{DynamicResource Nox.Brush.TextTertiary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Style="{StaticResource AssetPropertiesContentStyle}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="44"
                                Height="44"
                                Background="{DynamicResource Nox.Brush.IconBackground}"
                                BorderBrush="{DynamicResource Nox.Brush.IconBorder}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Nox.Brush.Accent}" />
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource Nox.Brush.TextHeading}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource Nox.Brush.TextTertiary}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Kind" Style="{StaticResource AssetPropertiesLabelStyle}" />
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource AssetPropertiesValueStyle}" />

                    <TextBlock Text="Relative Path" Style="{StaticResource AssetPropertiesLabelStyle}" />
                    <TextBlock Text="{Binding RelativePath}" Style="{StaticResource AssetPropertiesValueStyle}" />

                    <TextBlock Text="Full Path" Style="{StaticResource AssetPropertiesLabelStyle}" />
                    <TextBlock Text="{Binding FullPath}" Style="{StaticResource AssetPropertiesValueStyle}" />

                    <TextBlock Text="GUID" Style="{StaticResource AssetPropertiesLabelStyle}" />
                    <TextBlock Text="{Binding Guid}" Style="{StaticResource AssetPropertiesValueStyle}" />

                    <TextBlock Text="Size" Style="{StaticResource AssetPropertiesLabelStyle}" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource AssetPropertiesValueStyle}" />

                    <TextBlock Text="Modified" Style="{StaticResource AssetPropertiesLabelStyle}" />
                    <TextBlock Text="{Binding LastWriteTime}" Style="{StaticResource AssetPropertiesValueStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

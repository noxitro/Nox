<UserControl x:Class="Core.UI.Views.MemoryProfilerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:noxui="clr-namespace:NoxUI;assembly=NoxUI"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:MemoryProfilerViewModel, IsDesignTimeCreatable=False}"
             noxui:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="NoxStudio.MemoryProfilerView">
    <Border Background="{DynamicResource Nox.Brush.SurfaceBackground}"
            BorderBrush="{DynamicResource Nox.Brush.GridLine}"
            BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="8"
                    Background="{DynamicResource Nox.Brush.HeaderBackground}"
                    BorderBrush="{DynamicResource Nox.Brush.GridLine}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Memory Profiler"
                                   Foreground="{DynamicResource Nox.Brush.TextHeading}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource Nox.Brush.TextMuted}"
                                   FontSize="11" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Content="Auto"
                              IsChecked="{Binding AutoRefresh}"
                              Foreground="{DynamicResource Nox.Brush.TextPrimary}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0" />
                    <Button Grid.Column="2"
                            Content="Refresh"
                            MinWidth="84"
                            Padding="8,3"
                            Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top"
                    Padding="8"
                    Background="{DynamicResource Nox.Brush.SurfaceRaised}"
                    BorderBrush="{DynamicResource Nox.Brush.GridLine}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding SummaryText}"
                           Foreground="{DynamicResource Nox.Brush.TextPrimary}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Background="{DynamicResource Nox.Brush.SurfaceBackground}">
                <TextBlock AutomationProperties.AutomationId="NoxStudio.MemoryProfiler.EmptyState"
                           AutomationProperties.Name="No memory allocations to display. Connect Runtime and refresh the profiler."
                           Text="No memory allocations to display. Connect Runtime and refresh the profiler."
                           Foreground="{DynamicResource Nox.Brush.TextMuted}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Panel.ZIndex="2"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Allocations.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListView ItemsSource="{Binding Allocations}"
                          Background="Transparent"
                          Foreground="{DynamicResource Nox.Brush.TextPrimary}"
                          BorderThickness="0"
                          Panel.ZIndex="1"
                          AutomationProperties.AutomationId="NoxStudio.MemoryProfiler.Allocations"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.Resources>
                    <StaticResource x:Key="{x:Static SystemColors.ControlBrushKey}" ResourceKey="Nox.Brush.SurfaceBackground" />
                    <StaticResource x:Key="{x:Static SystemColors.ControlTextBrushKey}" ResourceKey="Nox.Brush.TextPrimary" />
                    <StaticResource x:Key="{x:Static SystemColors.HighlightBrushKey}" ResourceKey="Nox.Brush.SelectionBackground" />
                    <StaticResource x:Key="{x:Static SystemColors.HighlightTextBrushKey}" ResourceKey="Nox.Brush.TextStrong" />
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Handle" DisplayMemberBinding="{Binding ProfileHandle}" Width="70" />
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="90" />
                        <GridViewColumn Header="Align" DisplayMemberBinding="{Binding AlignSize}" Width="70" />
                        <GridViewColumn Header="Instance" DisplayMemberBinding="{Binding InstanceType}" Width="110" />
                        <GridViewColumn Header="Segment" DisplayMemberBinding="{Binding SegmentType}" Width="100" />
                        <GridViewColumn Header="Call Stack" DisplayMemberBinding="{Binding CallStack}" Width="420" />
                    </GridView>
                </ListView.View>
                </ListView>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>

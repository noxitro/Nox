<UserControl x:Class="Core.UI.Views.RuntimeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Core.UI.Views"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RuntimeControlViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="64" d:DesignWidth="1200"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CommandBarBackgroundBrush" Color="#FF1D2229" />
        <SolidColorBrush x:Key="CommandBarBorderBrush" Color="#FF2F3742" />
        <SolidColorBrush x:Key="CommandButtonBackgroundBrush" Color="#FF262C35" />
        <SolidColorBrush x:Key="CommandButtonHoverBrush" Color="#FF303847" />
        <SolidColorBrush x:Key="CommandButtonPressedBrush" Color="#FF1B2028" />
        <SolidColorBrush x:Key="CommandButtonBorderBrush" Color="#FF3B4554" />
        <SolidColorBrush x:Key="CommandButtonForegroundBrush" Color="#FFE7EAEE" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF98A2B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF41D6A4" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF51E7B4" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFE86969" />

        <Style x:Key="ModernCommandButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{StaticResource CommandButtonForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource CommandButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CommandButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CommandButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#FF526174" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource CommandButtonPressedBrush}" />
                    <Setter Property="BorderBrush" Value="#FF627084" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryCommandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernCommandButtonStyle}">
            <Setter Property="Foreground" Value="#FF071411" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#FF68F0C3" />
            <Setter Property="MinWidth" Value="104" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#FF7AF8CE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerCommandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernCommandButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFECEC" />
            <Setter Property="BorderBrush" Value="#FF7A3E43" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource CommandBarBackgroundBrush}"
            BorderBrush="{StaticResource CommandBarBorderBrush}"
            BorderThickness="0,1,0,1">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="34"
                        Height="34"
                        CornerRadius="9"
                        Background="#FF26303B"
                        BorderBrush="#FF374557"
                        BorderThickness="1">
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Nox Studio"
                               Foreground="#FFF2F4F7"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Editor Runtime Controls"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="6"
                    VerticalAlignment="Center"
                    Background="#FF151A20"
                    BorderBrush="#FF2B3440"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ModernCommandButtonStyle}"
                            Command="{Binding RebootCommand}"
                            ToolTip="Runtime を再起動します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Reboot" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryCommandButtonStyle}"
                            Command="{Binding PlayCommand}"
                            ToolTip="Runtime を再生します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Play" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DangerCommandButtonStyle}"
                            Command="{Binding StopCommand}"
                            ToolTip="Runtime を停止します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernCommandButtonStyle}"
                            MinWidth="112"
                            Command="{Binding StartConnectionCommand}"
                            ToolTip="Runtime との TCP/IP 接続を開始します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Connect" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Border Height="28"
                        Padding="12,0"
                        CornerRadius="14"
                        Background="#FF202731"
                        BorderBrush="#FF354052"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource AccentBrush}"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="Ready"
                                   Foreground="#FFD8DEE9"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

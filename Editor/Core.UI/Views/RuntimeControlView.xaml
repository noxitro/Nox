<UserControl x:Class="Core.UI.Views.RuntimeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Core.UI.Views"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RuntimeControlViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="64" d:DesignWidth="1200"
             prism:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="NoxStudio.RuntimeControlView">

    <UserControl.Resources>
        <Style x:Key="ModernCommandButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.TextHeading}" />
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Nox.Brush.ControlBackgroundHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.ControlBorderHover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Nox.Brush.ControlBackgroundPressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.ControlBorderPressed}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryCommandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernCommandButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.AccentForeground}" />
            <Setter Property="Background" Value="{DynamicResource Nox.Brush.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.AccentBorder}" />
            <Setter Property="MinWidth" Value="104" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Nox.Brush.AccentHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.AccentBorderHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerCommandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ModernCommandButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Nox.Brush.DangerForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Nox.Brush.DangerBorder}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Nox.Brush.CommandBarBackground}"
            BorderBrush="{DynamicResource Nox.Brush.GridLine}"
            BorderThickness="0,1,0,1">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="34"
                        Height="34"
                        CornerRadius="9"
                        Background="{DynamicResource Nox.Brush.IconBackground}"
                        BorderBrush="{DynamicResource Nox.Brush.IconBorder}"
                        BorderThickness="1">
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                                Foreground="{DynamicResource Nox.Brush.Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Nox Studio"
                               Foreground="{DynamicResource Nox.Brush.TextStrong}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Editor Runtime Controls"
                                Foreground="{DynamicResource Nox.Brush.TextSubtle}"
                               FontSize="11" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="6"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Nox.Brush.CommandBarBadgeBackground}"
                    BorderBrush="{DynamicResource Nox.Brush.GridLine}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                     <Button Style="{StaticResource ModernCommandButtonStyle}"
                             AutomationProperties.AutomationId="NoxStudio.RuntimeControl.RebootButton"
                             Command="{Binding RebootCommand}"
                            ToolTip="Runtime を再起動します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Reboot"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                     <Button Style="{StaticResource PrimaryCommandButtonStyle}"
                             AutomationProperties.AutomationId="NoxStudio.RuntimeControl.PlayButton"
                             Command="{Binding PlayCommand}"
                            ToolTip="Runtime を再生します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Play"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                     <Button Style="{StaticResource DangerCommandButtonStyle}"
                             AutomationProperties.AutomationId="NoxStudio.RuntimeControl.StopButton"
                             Command="{Binding StopCommand}"
                            ToolTip="Runtime を停止します">
                        <StackPanel Orientation="Horizontal">
                             <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Nox.Brush.Danger}" />
                            <TextBlock Text="Stop"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                     <Button Style="{StaticResource ModernCommandButtonStyle}"
                             AutomationProperties.AutomationId="NoxStudio.RuntimeControl.ConnectButton"
                             MinWidth="112"
                            Command="{Binding StartConnectionCommand}"
                            ToolTip="Runtime との TCP/IP 接続を開始します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Connect"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Border Height="28"
                        Padding="12,0"
                        CornerRadius="14"
                        Background="{DynamicResource Nox.Brush.CommandBadgeBackground}"
                        BorderBrush="{DynamicResource Nox.Brush.BadgeBorder}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                  Fill="{DynamicResource Nox.Brush.Accent}"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="Ready"
                                   Foreground="{DynamicResource Nox.Brush.TextHeading}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="Core.UI.Views.RuntimeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Core.UI.Views"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             xmlns:noxui="clr-namespace:NoxUI;assembly=NoxUI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RuntimeControlViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="64" d:DesignWidth="1200"
             noxui:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="NoxStudio.RuntimeControlView">

    <UserControl.Resources>
        <Style x:Key="RuntimeCommandButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource Nox.CommandButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RuntimePrimaryCommandButtonStyle"
               TargetType="Button"
                BasedOn="{StaticResource Nox.PrimaryCommandButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style x:Key="RuntimeDangerCommandButtonStyle"
               TargetType="Button"
                BasedOn="{StaticResource Nox.DangerCommandButtonStyle}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Nox.Brush.CommandBarBackground}"
            BorderBrush="{DynamicResource Nox.Brush.GridLine}"
            BorderThickness="0">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Width="30"
                        Height="30"
                        CornerRadius="4"
                        Background="{DynamicResource Nox.Brush.IconBackground}"
                        BorderBrush="{DynamicResource Nox.Brush.IconBorder}"
                        BorderThickness="1">
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                                Foreground="{DynamicResource Nox.Brush.Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Nox Studio"
                               Foreground="{DynamicResource Nox.Brush.TextStrong}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Editor  /  Runtime"
                               Style="{StaticResource Nox.DataTextStyle}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="5"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Nox.Brush.CommandBarBadgeBackground}"
                    BorderBrush="{DynamicResource Nox.Brush.GridLine}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RuntimeCommandButtonStyle}"
                            AutomationProperties.AutomationId="NoxStudio.RuntimeControl.ConnectButton"
                            MinWidth="104"
                            Command="{Binding StartConnectionCommand}"
                            ToolTip="Runtime との TCP/IP 接続を開始します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,7,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Connect"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource RuntimePrimaryCommandButtonStyle}"
                            AutomationProperties.AutomationId="NoxStudio.RuntimeControl.PlayButton"
                            Command="{Binding PlayCommand}"
                            ToolTip="Runtime を再生します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,7,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Play"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource RuntimeDangerCommandButtonStyle}"
                            AutomationProperties.AutomationId="NoxStudio.RuntimeControl.StopButton"
                            Command="{Binding StopCommand}"
                            ToolTip="Runtime を停止します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" Foreground="{DynamicResource Nox.Brush.Danger}" />
                            <TextBlock Text="Stop"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="5,3" Background="{DynamicResource Nox.Brush.GridLine}" />

                    <Button Style="{StaticResource RuntimeCommandButtonStyle}"
                             AutomationProperties.AutomationId="NoxStudio.RuntimeControl.RebootButton"
                             Command="{Binding RebootCommand}"
                            ToolTip="Runtime を再起動します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text=""
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,7,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="Reboot"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Border Height="28"
                        Padding="10,0"
                        CornerRadius="4"
                        Background="{DynamicResource Nox.Brush.CommandBadgeBackground}"
                        BorderBrush="{DynamicResource Nox.Brush.BadgeBorder}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Rectangle Width="8"
                                  Height="8"
                                  RadiusX="1"
                                  RadiusY="1"
                                  Fill="{DynamicResource Nox.Brush.TextMuted}"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="PROCESS ISOLATED"
                                   Style="{StaticResource Nox.DataTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

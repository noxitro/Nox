<UserControl x:Class="Core.UI.Views.ProjectSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:noxui="clr-namespace:NoxUI;assembly=NoxUI"
             xmlns:views="clr-namespace:Core.UI.Views"
             xmlns:vm="clr-namespace:Core.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="980"
             d:DataContext="{d:DesignInstance vm:ProjectSettingsViewModel, IsDesignTimeCreatable=False}"
             noxui:ViewModelLocator.AutoWireViewModel="True"
             AutomationProperties.AutomationId="NoxStudio.ProjectSettingsView">
    <Border Background="{DynamicResource Nox.Brush.SurfaceBackground}" BorderBrush="{DynamicResource Nox.Brush.GridLine}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="10" Background="{DynamicResource Nox.Brush.HeaderBackground}" BorderBrush="{DynamicResource Nox.Brush.GridLine}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Project Settings" Foreground="{DynamicResource Nox.Brush.TextHeading}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Nox.Brush.TextTertiary}" Margin="10,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Save"
                            AutomationProperties.AutomationId="NoxStudio.ProjectSettings.SaveButton"
                            Height="28"
                            MinWidth="80"
                            Command="{Binding SaveCommand}" />
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectSettingsGroupViewModel}">
                            <Border Margin="0,0,0,12" Padding="12" Background="{DynamicResource Nox.Brush.SurfaceRaised}" BorderBrush="{DynamicResource Nox.Brush.GridLine}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource Nox.Brush.Accent}" FontWeight="SemiBold" />
                                        <TextBlock Text=" / " Foreground="{DynamicResource Nox.Brush.TextMuted}" />
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Nox.Brush.TextHeading}" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <views:PropertyInspectorView ItemsSource="{Binding Properties}"
                                                                 LabelWidth="220"
                                                                 PropertyInspectorAutomationId="NoxStudio.ProjectSettings.PropertyInspector"
                                                                 Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

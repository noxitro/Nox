<UserControl x:Class="Core.UI.Views.DocumentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TabItem">
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TabItem_OnPreviewMouseLeftButtonDown" />
                <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu ItemsSource="{Binding Children}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Header}" />
                                    <Setter Property="Command" Value="{Binding Command}" />
                                    <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                                    <Setter Property="Icon">
                                        <Setter.Value>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="18" TextAlignment="Center" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ItemsSource" Value="{Binding Children}" />
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <!-- 上部タブ -->
        <TabControl Height="32"
                    Background="#FF2B2B2B"
                    BorderThickness="0"
                    Padding="0"
                    ItemsSource="{Binding TabTable}"
                    SelectionChanged="TabControl_OnSelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}">
                        <TabPanel IsItemsHost="True"
                                  Background="{TemplateBinding Background}"
                                  Margin="4,0,4,0" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="8,0">
                        <TextBlock Text="{Binding Header}" />
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>
    </Grid>
</UserControl>

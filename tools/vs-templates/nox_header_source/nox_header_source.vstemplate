<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Item">
	<TemplateData>
		<DefaultName>nox_header_source</DefaultName>
		<Name>nox_header_source</Name>
		<Description>Create paired .h and .cpp files</Description>
		<ProjectType>VC</ProjectType>
		<SortOrder>10</SortOrder>
		<Icon>__TemplateIcon.ico</Icon>
	</TemplateData>
	<TemplateContent>
		<References />
		<ProjectItem SubType="" ReplaceParameters="true" TargetFileName="$safeitemname$.cpp">nox_source.cpp</ProjectItem>
		<ProjectItem SubType="" ReplaceParameters="true" TargetFileName="$safeitemname$.h">nox_header.h</ProjectItem>
	</TemplateContent>
</VSTemplate>

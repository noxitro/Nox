<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="ソース ファイル">
      <UniqueIdentifier>{{{GUID_SOURCE_FILTER}}}</UniqueIdentifier>
      <Extensions>cpp;c;cc;cxx;c++;cppm;ixx</Extensions>
    </Filter>
    <Filter Include="ヘッダー ファイル">
      <UniqueIdentifier>{{{GUID_HEADER_FILTER}}}</UniqueIdentifier>
      <Extensions>h;hh;hpp;hxx;h++</Extensions>
    </Filter>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="{{MODULE_FILE}}.cpp">
      <Filter>ソース ファイル</Filter>
    </ClCompile>
    <ClCompile Include="pch.cpp">
      <Filter>ソース ファイル</Filter>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="{{PROJECT}}.h">
      <Filter>ヘッダー ファイル</Filter>
    </ClInclude>
    <ClInclude Include="{{MODULE_FILE}}.h">
      <Filter>ヘッダー ファイル</Filter>
    </ClInclude>
    <ClInclude Include="pch.h">
      <Filter>ヘッダー ファイル</Filter>
    </ClInclude>
  </ItemGroup>
</Project>

#!/bin/sh
# push しようとしている範囲を丸ごと見る。--no-verify でコミット時の
# チェックを飛ばしていても、外に出る直前にここで捕まえる。
set -u
DIR=$(dirname "$0")
ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # ブランチ削除

  if [ "$remote_sha" = "$ZERO" ]; then
    # 新規ブランチ。既に push 済みのものを除いた範囲だけ見る。
    range=$(git rev-list "$local_sha" --not --remotes | tail -1)
    [ -n "$range" ] && range="$range^..$local_sha" || range="$local_sha"
    files=$(git diff --name-only "$range" 2>/dev/null || git ls-tree -r --name-only "$local_sha")
  else
    files=$(git diff --name-only "$remote_sha..$local_sha")
  fi

  [ -n "$files" ] || continue
  echo "pre-push: $(printf '%s\n' "$files" | wc -l) ファイルを検査中…" >&2
  printf '%s\n' "$files" |
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      git cat-file -e "$local_sha:$p" 2>/dev/null && printf '%s\t%s:%s\n' "$p" "$local_sha" "$p"
    done |
    sh "$DIR/scan.sh" || status=1
done

exit $status
